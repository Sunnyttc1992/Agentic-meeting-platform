# Local server configuration only. Copy this file to .env and replace values
# locally. Never commit .env or paste a real key into chat.
#
# The Vite client never receives these variables: do not use a VITE_ prefix.

# Optional. Enables server-side Claude summaries after local Whisper has
# transcribed a recording. Leave blank to run in transcript-only mode.
ANTHROPIC_API_KEY=
# Only for an organization-level key that is not scoped to a workspace:
# the workspace ID (wrkspc_...) to send with each request. Not a secret.
# ANTHROPIC_WORKSPACE_ID=

# Optional alternative summary provider. Set MEETING_SUMMARY_PROVIDER to pick
# one explicitly (openai, anthropic, or none); without it, Anthropic is used
# when its key is set, then OpenAI.
# MEETING_SUMMARY_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_SUMMARY_MODEL=gpt-5.5

# Optional meeting chat answers (off by default). Chat sends the question,
# matching excerpts from several meetings, and recent chat turns to this
# provider, a wider flow than summaries; see the approval packets first.
# Without it, chat still shows matching excerpts locally.
# MEETING_CHAT_PROVIDER=openai
# OPENAI_CHAT_MODEL=gpt-5.5
# Meaning-based chat retrieval uses a local embedding model through Ollama on
# this computer (run: ollama pull bge-m3). Set to none for keyword-only search.
# MEETING_EMBEDDING_MODEL=bge-m3
# Chat guardrail and memory settings (defaults shown): questions per user per
# day, and how many days saved chat is kept before the sweep deletes it.
# MEETING_CHAT_DAILY_LIMIT=200
# MEETING_CHAT_RETENTION_DAYS=90
# OLLAMA_URL=http://127.0.0.1:11434

# Optional local-only tuning. The defaults are shown for reference.
# WHISPER_MODEL=onnx-community/whisper-base
# WHISPER_LANGUAGE=en
# MEETING_SUMMARY_MODEL=claude-sonnet-5-5
# MEETING_PROCESSOR=local
# PORT=4173
# Optional local-only pyannote diarization. Leave both blank to retain
# UNATTRIBUTED transcript speakers. Do not put a Hugging Face token here.
# DIARIZATION_PYTHON=C:\\Python311\\python.exe
# DIARIZATION_MODEL_DIR=C:\\ProgramData\\MeetingLedger\\models\\speaker-diarization-community-1
# MEETING_DIARIZATION_TEMP_DIR=C:\\ProgramData\\MeetingLedger\\diarization-tmp

# Optional: self-hosted PostgreSQL instead of the local SQLite file.
# The server connects as a least-privilege application role (never a superuser
# or the tables' owner) and refuses to start otherwise. Use TLS.
# DATABASE_URL=postgres://meeting_app:CHANGE_ME@db.internal:5432/meeting_ledger?sslmode=require
# Required with DATABASE_URL: path to the 32-byte recording audio key file.
# MEETING_AUDIO_KEY_FILE=/etc/meeting-ledger/recording-audio-v1.key
# Optional: server-writable folder for per-recording audio keys, kept out of
# the database dump so deletion destroys audio cryptographically.
# Default: .data/recording-keys
# MEETING_RECORDING_KEY_DIR=C:\ProgramData\MeetingLedger\recording-keys
# DATABASE_POOL_MAX=10
# Only for `npm run db:migrate`, run by the role that owns the tables:
# DATABASE_ADMIN_URL=postgres://ledger_owner:CHANGE_ME@db.internal:5432/meeting_ledger?sslmode=require
# MEETING_DB_APP_ROLE=meeting_app
