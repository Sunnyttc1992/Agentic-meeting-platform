# Local server configuration only. Copy this file to .env and replace values
# locally. Never commit .env or paste a real key into chat.
#
# The Vite client never receives these variables: do not use a VITE_ prefix.

# Optional. Enables server-side Claude summaries after local Whisper has
# transcribed a recording. Leave blank to run in transcript-only mode.
ANTHROPIC_API_KEY=

# Optional local-only tuning. The defaults are shown for reference.
# WHISPER_MODEL=onnx-community/whisper-base
# WHISPER_LANGUAGE=en
# MEETING_SUMMARY_MODEL=claude-sonnet-5-5
# MEETING_PROCESSOR=local
# PORT=4173
