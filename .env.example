# Local server configuration only. Copy this file to .env and replace values
# locally. Never commit .env or paste a real key into chat.
#
# The Vite client never receives these variables: do not use a VITE_ prefix.

# Optional. Enables server-side Claude summaries after local Whisper has
# transcribed a recording. Leave blank to run in transcript-only mode.
ANTHROPIC_API_KEY=

# Optional local-only tuning. The defaults are shown for reference.
# WHISPER_MODEL=onnx-community/whisper-base
# WHISPER_LANGUAGE=en
# MEETING_SUMMARY_MODEL=claude-sonnet-5-5
# MEETING_PROCESSOR=local
# PORT=4173

# Optional: self-hosted PostgreSQL instead of the local SQLite file.
# The server connects as a least-privilege application role (never a superuser
# or the tables' owner) and refuses to start otherwise. Use TLS.
# DATABASE_URL=postgres://meeting_app:CHANGE_ME@db.internal:5432/meeting_ledger?sslmode=require
# Required with DATABASE_URL: path to the 32-byte recording audio key file.
# MEETING_AUDIO_KEY_FILE=/etc/meeting-ledger/recording-audio-v1.key
# DATABASE_POOL_MAX=10
# Only for `npm run db:migrate`, run by the role that owns the tables:
# DATABASE_ADMIN_URL=postgres://ledger_owner:CHANGE_ME@db.internal:5432/meeting_ledger?sslmode=require
# MEETING_DB_APP_ROLE=meeting_app
