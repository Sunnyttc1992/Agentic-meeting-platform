# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Local-only dependencies, model weights, caches, and generated build output
node_modules/
.npm-cache/
.cache/
dist/

# Local server secrets. Example templates are deliberately kept trackable.
.env
.env.*
!.env.example
!.env.*.example
