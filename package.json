{
  "name": "executive-meeting-ledger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "node --env-file-if-exists=.env server/local-preview.js",
    "test": "node --test server/**/*.test.js tests/recording-machine.test.mjs tests/sites-worker.test.mjs",
    "test:server": "node --test server/**/*.test.js",
    "test:frontend": "node --test tests/recording-machine.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db-migrate.js",
    "eval:summaries": "node --env-file-if-exists=.env scripts/eval-meeting-intelligence.mjs",
    "eval:rag": "node --env-file-if-exists=.env scripts/eval-rag.mjs",
    "benchmark:diarization": "node --env-file-if-exists=.env scripts/benchmark-diarization.mjs",
    "benchmark:real-audio": "node --env-file-if-exists=.env scripts/benchmark-real-audio.mjs",
    "verify:release": "node scripts/verify-release-evidence.mjs",
    "smoke:browser": "powershell -ExecutionPolicy Bypass -File scripts/run-studio-browser-smoke.ps1",
    "prototype:export": "powershell -ExecutionPolicy Bypass -File scripts/export-local-prototype.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "openai": "^7.28.0",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
